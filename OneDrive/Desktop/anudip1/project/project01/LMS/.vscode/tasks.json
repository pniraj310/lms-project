{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Backend and Frontend",
      "type": "shell",
      "command": "javac",
      "args": [
        "-cp",
        ".;lib/postgresql.jar",
        "-d",
        "bin",
        "backend/src/DatabaseConnection.java",
        "backend/src/User.java",
        "backend/src/Course.java",
        "backend/src/Enrollment.java",
        "backend/src/UserDAO.java",
        "backend/src/CourseDAO.java",
        "backend/src/EnrollmentDAO.java",
        "backend/src/TestDatabase.java",
        "backend/src/DiagnosticTest.java",
        "frontend/src/LMSFrame.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "Test Database Connection (Diagnostic)",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "bin;lib/postgresql.jar",
        "DiagnosticTest"
      ],
      "group": "test"
    },
    {
      "label": "Run LMS Frontend",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "bin;lib/postgresql.jar",
        "LMSFrame"
      ],
      "group": "test"
    }
  ]
}
